# ── Site ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Neon (Postgres) — from `neon deploy` / `neon env pull` ────────────
# Pooled URL for the Next.js app (preferred for serverless)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
# Direct URL for migrations (drizzle-kit push)
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
NEON_BRANCH=production

# ── Clerk (auth) ──────────────────────────────────────────────────────
NEXT_PUBLIC_AUTH_ENABLED=true
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Comma-separated admin emails, e.g. first@example.com,second@example.com
STORE_ADMIN_EMAILS=yasbeautyallure6@gmail.com

# ── Cloudinary (admin image uploads) ──────────────────────────────────
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ── Paystack (checkout) ───────────────────────────────────────────────
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_SECRET_KEY=sk_test_...
# Dashboard → Settings → API Keys & Webhooks → Webhook URL:
#   {NEXT_PUBLIC_SITE_URL}/api/paystack/webhook
# Subscribe to at least: charge.success

# ── Resend (order + booking emails) ───────────────────────────────────
# https://resend.com/api-keys — also set these on Vercel → Settings → Environment Variables
RESEND_API_KEY=re_...
# Address on a Resend-verified domain. Gmail/Yahoo/etc will be rejected.
# Until then use: Yas Beauty Allure <onboarding@resend.dev>
RESEND_FROM="Yas Beauty Allure <onboarding@resend.dev>"
# Optional override for admin alerts (defaults to STORE_ADMIN_EMAILS)
# RESEND_ADMIN_TO=hadesanoye01@gmail.com
