# ── Site ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Neon (Postgres) — from `neon deploy` / `neon env pull` ────────────
# Pooled URL for the Next.js app (preferred for serverless)
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require
# Direct URL for migrations (drizzle-kit push)
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
NEON_BRANCH=production

# ── Clerk (auth) ──────────────────────────────────────────────────────
NEXT_PUBLIC_AUTH_ENABLED=true
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Comma-separated admin emails, e.g. first@example.com,second@example.com
STORE_ADMIN_EMAILS=yasbeautyallure6@gmail.com

# ── Cloudinary (admin image uploads) ──────────────────────────────────
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# ── Paystack (checkout) ───────────────────────────────────────────────
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_SECRET_KEY=sk_test_...
# Dashboard → Settings → API Keys & Webhooks → Webhook URL:
#   {NEXT_PUBLIC_SITE_URL}/api/paystack/webhook
# Subscribe to at least: charge.success

# ── Resend (order + booking emails) ───────────────────────────────────
# https://resend.com/api-keys — verify your domain, then set FROM
RESEND_API_KEY=re_...
# e.g. Yas Beauty Allure <yasbeautyallure6@gmail.com>
# Until a domain is verified, Resend allows: Yas Beauty Allure <onboarding@resend.dev>
RESEND_FROM="Yas Beauty Allure <yasbeautyallure6@gmail.com>"
# Optional override for admin alerts (defaults to STORE_ADMIN_EMAILS)
# RESEND_ADMIN_TO=yasbeautyallure6@gmail.com
